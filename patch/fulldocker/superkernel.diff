+
+enum {
+	MIDAS_ID_PID = 0,
+	MIDAS_ID_TGID,
+	MIDAS_ID_UID,
+	MIDAS_ID_TOTAL,
+};
+
+enum {
+	MIDAS_TYPE_NONE = 0,
+	MIDAS_TYPE_PROCESS,
+	MIDAS_TYPE_APP,
+	MIDAS_TYPE_TOTAL,
+};
+
+struct midas_id_entry {
+	unsigned int id[MIDAS_ID_TOTAL];
+	unsigned int type;
+	char pid_name[TASK_COMM_LEN];
