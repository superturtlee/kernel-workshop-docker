+/* 将 cgroup 指针存入 mutex 的 OEM 预留字段（第一个 u64） */
+static inline void perf_cpu_ctx_set_cgrp(struct perf_cpu_context *cpuctx,
+					 struct perf_cgroup *cgrp)
+{
+	struct mutex *mutex = &cpuctx->ctx.mutex;
+	mutex->android_oem_data1[1] = (u64)(uintptr_t)cgrp;
+}
+
+static inline struct perf_cgroup *
+perf_cpu_ctx_get_cgrp_readonce(struct perf_cpu_context *cpuctx)
+{
+	struct mutex *mutex = &cpuctx->ctx.mutex;
+	uintptr_t ptr;
+
+	/* 使用 READ_ONCE 确保读取的原子性/volatile */
+	ptr = (uintptr_t)READ_ONCE(mutex->android_oem_data1[1]);
+	return (struct perf_cgroup *)ptr;
+}
+
+/* 从 mutex 的 OEM 预留字段读取 cgroup 指针 */
+static inline struct perf_cgroup *
+perf_cpu_ctx_get_cgrp(struct perf_cpu_context *cpuctx)
+{
+	struct mutex *mutex = &cpuctx->ctx.mutex;
+	return (struct perf_cgroup *)(uintptr_t)mutex->android_oem_data1[1];
+}
